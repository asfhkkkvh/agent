# ── OmniRAG Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── 智谱 GLM (https://open.bigmodel.cn/) ───────────────────────────────────
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
ZHIPU_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-3

# ── LangSmith Tracing (Free tier: https://smith.langchain.com) ────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=omnirag-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Qdrant Cloud (Free 1GB tier: https://cloud.qdrant.io) ─────────────────────
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=omnirag_hybrid

# ── Tavily Web Search (Free 1000 req/month: https://tavily.com) ───────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── 评估（黄金集 + LLM-as-judge）────────────────────────────────────────────
# 黄金集：人工校验的 (query, ground_truth, source) JSON 数组
EVAL_GOLDEN_PATH=data/golden_set.json
EVAL_REPORT_DIR=data/eval_reports

# ── RAG Tuning ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANKER_TOP_N=5
# 元数据过滤器提取：默认关（GLM 易误判 query 为 source 导致 0 命中，且每查询多一次 LLM 调用）
USE_FILTER_EXTRACTION=false
# 小 chunk（400/40）+ 按 Markdown 标题优先切分保证主题聚焦，避免多主题大块稀释检索余弦
# 注意：此默认值与 app/config.py 保持一致，避免配置漂移
CHUNK_SIZE=400
CHUNK_OVERLAP=40

# ── 多查询扩展（可选，会增加一次 LLM 调用）────────────────────────────
USE_MULTI_QUERY=false
MULTI_QUERY_COUNT=3

# ── 对话记忆 ──────────────────────────────────────────────────────────────
HISTORY_WINDOW=6

# ── Agent Settings ────────────────────────────────────────────────────────────
# 评审闭环最大轮数：2 即可保证质量与响应速度的平衡
# （各 Agent 温度统一在 app/llm.py 按角色指定，无全局 AGENT_TEMPERATURE）
MAX_ITERATIONS=2

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
