# ── OmniRAG Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── 智谱 GLM (https://open.bigmodel.cn/) ───────────────────────────────────
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
ZHIPU_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-3

# ── LangSmith Tracing (Free tier: https://smith.langchain.com) ────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=omnirag-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Qdrant Cloud (Free 1GB tier: https://cloud.qdrant.io) ─────────────────────
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=omnirag_hybrid

# ── Tavily Web Search (Free 1000 req/month: https://tavily.com) ───────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Neo4j Aura Free (200K nodes free: https://neo4j.io/aura-free) ──────────────
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── KG & RAGAS 评估开关 ──────────────────────────────────────────────────────
USE_KG_RETRIEVAL=true
KG_TOP_K=5
EVAL_DATASET_SIZE=20
EVAL_REPORT_DIR=data/eval_reports

# ── RAG Tuning ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANKER_TOP_N=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── 多查询扩展（可选，会增加一次 LLM 调用）────────────────────────────
USE_MULTI_QUERY=false
MULTI_QUERY_COUNT=3

# ── 对话记忆 ──────────────────────────────────────────────────────────────
HISTORY_WINDOW=6

# ── Agent Settings ────────────────────────────────────────────────────────────
MAX_ITERATIONS=5
AGENT_TEMPERATURE=0.0

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
